# Copy to scripts/remote-test-target.env (gitignored -- never commit real
# host/credentials, this repo is public) and fill in the real values to
# enable scripts/deploy-remote-test.sh.
#
# 2026-09-07: confirmed a real "remote-test" host is the backend behind
# mesflow.net (self-reports server_role=PRODUCTION_TEST via its own
# /api/system/ready; version/commit shown at https://mesflow.net matched
# byte-for-byte after a deploy through this exact mechanism). It is a
# TEST environment, not production -- there is no confirmed real
# production host as of this date (see docs/DEPLOY_ARCHITECTURE_A.md;
# that investigation's conclusions are unchanged, this is a separate,
# newly-confirmed TEST target, not a re-classification of "production").
# The real host/IP is deliberately not written anywhere in this repo
# (public) -- it lives only in the gitignored scripts/remote-test-target.env
# on whichever machine actually runs deploys.
#
# The day-to-day maintenance SSH account on this host (used for backups/
# log-retention) is deliberately NOT in sudoers. REMOTE_TEST_SSH_USER
# below must be a DIFFERENT account with passwordless sudo (confirmed via
# `sudo -n true` before relying on it) -- deploy-remote-test.sh
# sudo-prefixes every docker/compose/.env-touching command explicitly and
# will fail loudly if that assumption doesn't hold.

REMOTE_TEST_SSH_HOST=203.0.113.10
REMOTE_TEST_SSH_USER=changeme
REMOTE_TEST_REMOTE_DIR=/opt/mesflow
REMOTE_TEST_APP_SERVICE=mesflow
REMOTE_TEST_APP_CONTAINER=mesflow-app
REMOTE_TEST_NETWORK=mesflow_network
REMOTE_TEST_APP_PORT=8080
REMOTE_TEST_PUBLIC_URL=https://mesflow.net
