diff --git a/nginx/nginx.conf b/nginx/nginx.conf
index 2f3fca8..f3914a0 100644
--- a/nginx/nginx.conf
+++ b/nginx/nginx.conf
@@ -23,6 +23,13 @@ http {
     keepalive 32;
   }
 
+  # MESFlow Server Agent runs directly on the Linux host. Docker Compose maps
+  # host.docker.internal to the host gateway so this container can reach :8090.
+  upstream mesflow_agent_backend {
+    server host.docker.internal:8090;
+    keepalive 16;
+  }
+
   server {
     listen 80;
     listen [::]:80;
@@ -148,4 +155,58 @@ http {
       proxy_buffering off;
     }
   }
+
+  # Server Agent public endpoint: https://agent.mesflow.net -> Linux host :8090
+  server {
+    listen 80;
+    listen [::]:80;
+    server_name agent.mesflow.net;
+
+    location = /nginx-health {
+      default_type text/plain;
+      return 200 "agent nginx ok\n";
+    }
+
+    location / {
+      return 301 https://agent.mesflow.net$request_uri;
+    }
+  }
+
+  server {
+    listen 443 ssl;
+    listen [::]:443 ssl;
+    http2 on;
+    server_name agent.mesflow.net;
+
+    # The existing origin certificate should include agent.mesflow.net or *.mesflow.net.
+    ssl_certificate /etc/nginx/certs/mesflow.net.pem;
+    ssl_certificate_key /etc/nginx/certs/mesflow.net.key;
+    ssl_protocols TLSv1.2 TLSv1.3;
+    ssl_session_cache shared:SSL:20m;
+    ssl_session_timeout 1d;
+
+    location = /nginx-health {
+      default_type text/plain;
+      return 200 "agent nginx ok\n";
+    }
+
+    location / {
+      proxy_pass http://mesflow_agent_backend;
+      proxy_http_version 1.1;
+      proxy_set_header Host $host;
+      proxy_set_header X-Forwarded-Host $host;
+      proxy_set_header X-Forwarded-Proto https;
+      proxy_set_header X-Forwarded-Port 443;
+      proxy_set_header X-Real-IP $remote_addr;
+      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+      proxy_set_header Upgrade $http_upgrade;
+      proxy_set_header Connection $connection_upgrade;
+      proxy_redirect off;
+      proxy_buffering off;
+      # Interactive SSH/WebSocket sessions may remain open for a long time.
+      proxy_read_timeout 3600s;
+      proxy_send_timeout 3600s;
+    }
+  }
+
 }
