[Unit]
Description=MESFlow scoped read-only OP anomaly batch (opt-in)

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/mesflow-ml-ops/current
Environment=PYTHONPATH=%h/.local/share/mesflow-ml-ops/current/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.local/share/mesflow-ml-ops/venv/bin/python -m mesflow.ml_ops.worker --config %h/.config/mesflow-ml-ops/config.json
TimeoutStartSec=600
MemoryMax=512M
CPUQuota=50%
TasksMax=16
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mesflow-ml-ops/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
