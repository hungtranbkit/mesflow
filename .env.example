# mesflow/.env.example
#
# Template for mesflow/.env — the env file mesflow/compose.yml loads
# (`env_file: .env`, required: false) for the mesflow-app / mesflow-postgres
# services defined in THIS project only. Copy to `mesflow/.env` and fill in
# real values; `mesflow/.env` is git-ignored and must never be committed.
#
# This file intentionally covers only the variables mesflow/compose.yml and
# app/mesflow/core/config.py actually read (verified against source, not
# guessed). For the combined workspace-level stack (Deploy Agent, QA Center)
# see the workspace-root ../.env.example instead — this file does not
# replace or compete with it.
#
# Required (compose fails fast / app falls back to insecure defaults without these):
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://mesflow:CHANGE_ME@postgres:5432/mesflow

# Optional, defaulted in compose.yml if unset — shown here with their real defaults:
POSTGRES_DB=mesflow
POSTGRES_USER=mesflow
WORKSHOP_DATABASE_URL=${DATABASE_URL}
MESFLOW_TIMEZONE=Asia/Ho_Chi_Minh
MESFLOW_ENABLE_FORCE_DELETE_PO=0
MESFLOW_TEST_AUTO_LOGIN=0
MESFLOW_TEST_AUTO_LOGIN_USERNAME=admin
MESFLOW_LOCAL_AUTO_LOGIN=0
MESFLOW_INTERNAL_QA_AUTO_LOGIN=0
MESFLOW_INTERNAL_HTTP_SESSION=1
MESFLOW_INTERNAL_API_TOKEN=
MESFLOW_LOG_RETENTION_ENABLED=1
MESFLOW_LOG_RETENTION_BATCH_SIZE=2000
MESFLOW_LOG_RETENTION_SUCCESS_DAYS=30
MESFLOW_LOG_RETENTION_SLOW_DAYS=90
MESFLOW_LOG_RETENTION_RESOLVED_ERROR_DAYS=180
MESFLOW_LOG_RETENTION_UNRESOLVED_ERROR_DAYS=365
MESFLOW_LOG_RETENTION_SECURITY_DAYS=365
MESFLOW_LOG_RETENTION_ERROR_TRACE_RESOLVED_DAYS=180
MESFLOW_LOG_RETENTION_ERROR_TRACE_UNRESOLVED_DAYS=365

# Read by app/mesflow/core/config.py but NOT set in compose.yml's `environment:`
# block (must come from this .env file / env_file, or the app falls back to
# an insecure "dev-only" secret key and an empty admin password):
MESFLOW_SECRET_KEY=CHANGE_ME
MESFLOW_ADMIN_USERNAME=admin
MESFLOW_ADMIN_PASSWORD=CHANGE_ME

# Never set MESFLOW_ENV here for a production /opt/mesflow deployment —
# compose.yml hardcodes MESFLOW_ENV=production for the mesflow-app service
# and this var is not overridable via .env for that service.

# --- Optional integrations (all default to disabled/empty; safe to omit) ---
# MESFLOW_SMTP_HOST=
# MESFLOW_SMTP_PORT=587
# MESFLOW_SMTP_USER=
# MESFLOW_SMTP_PASSWORD=
# MESFLOW_SMTP_FROM=
# MESFLOW_SMTP_TO=
# MESFLOW_TELEGRAM_BOT_TOKEN=
# MESFLOW_TELEGRAM_CHAT_ID=
# MESFLOW_AI_ENABLED=0
# MESFLOW_AI_PROVIDER=
# MESFLOW_AI_API_KEY=

# --- ProjectFlow local sandbox (compose.projectflow-local.yml) ---
# Not read from this .env file — that compose file hardcodes its own
# isolated, non-production credentials (see mesflow/PROJECT.yaml
# deployment.local.notes). MESFLOW_LOCAL_PORT / MESFLOW_IMAGE below are
# consumed directly by that compose file's ${VAR} substitution, so they
# DO work if exported in the shell or placed in this .env:
# MESFLOW_LOCAL_PORT=18280
# MESFLOW_IMAGE=mesflow-app:dev
